{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AppSettings": {
    "InitializeDatabaseOnStartup": false,
    "HoldExpiryCheckSeconds": 60,
    "TripGenerationIntervalMinutes": 60,
    "ReceiptsPath": "App_Data/receipts",
    "SeedDemoData": false,
    "OfficeUserEmail": "",
    "OfficeUserPassword": ""
  },
  "Booking": {
    "HoldMinutes": 15,
    "PassengerCancellationCutoffHours": 2,
    "BookingWindowDays": 7,
    "MaxReceiptBytes": 5242880,
    "InstaPayAddress": "",
    "OfficePhone": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sbus-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "sbus"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Email": {
      "From": "",
      "PublicOrigin": "https://localhost:7116",
      "Password": "",
      "Host": "",
      "Port": 587,
      "Username": ""
    },
    "RequireConfirmedEmail": true,
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}
