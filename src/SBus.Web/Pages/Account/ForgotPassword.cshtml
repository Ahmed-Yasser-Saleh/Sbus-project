@page
@model SBus.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<h1>@L["نسيت كلمة المرور؟"]</h1>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label asp-for="Email">@L["البريد الإلكتروني"]</label><input asp-for="Email" autocomplete="email" class="form-control" />
    <button class="btn btn-primary mt-3">@L["متابعة"]</button>
</form>

