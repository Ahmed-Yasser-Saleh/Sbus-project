@page
@model SBus.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<h1>@L["تغيير كلمة المرور"]</h1>
<p>@L["استخدم كلمة مرور من 5 حروف على الأقل."]</p>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="Code" />
    <label asp-for="Password">@L["كلمة المرور"]</label><input asp-for="Password" autocomplete="new-password" class="form-control" />
    <label asp-for="ConfirmPassword">@L["تأكيد كلمة المرور"]</label><input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control" />
    <button class="btn btn-primary mt-3">@L["متابعة"]</button>
</form>

