@page
@model SBus.Web.Pages.Office.IndexModel
@{
    ViewData["Title"] = L["رحلات اليوم"].Value;
    var date = Model.Date!.Value;
    var capacity = Model.Trips.Sum(t => t.Capacity);
    var confirmed = Model.Trips.Sum(t => t.ConfirmedSeats);
    var pending = Model.Trips.Sum(t => t.AwaitingSeats + t.HeldSeats);
    var free = capacity - confirmed - pending;
}

<div class="page-head">
    <div>
        <span class="eyebrow">@(date == Model.Today ? L["النهارده"] : L["الرحلات"])</span>
        <h1>@Fmt.Date(date)</h1>
    </div>
    <div class="date-nav">
        <a class="btn btn-outline-dark btn-sm" href="?date=@Fmt.IsoDate(date.AddDays(-1))" aria-label="@L["اليوم اللي قبله"]"><svg class="i i-flip"><use href="#i-back" /></svg></a>
        <a class="btn btn-outline-dark btn-sm" href="?date=@Fmt.IsoDate(Model.Today)">@L["النهارده"]</a>
        <a class="btn btn-outline-dark btn-sm" href="?date=@Fmt.IsoDate(date.AddDays(1))" aria-label="@L["اليوم اللي بعده"]"><svg class="i i-flip"><use href="#i-arrow" /></svg></a>
    </div>
</div>

<div class="stats">
    <div class="stat"><span class="stat-label">@L["الرحلات"]</span><span class="stat-value">@Model.Trips.Count</span></div>
    <div class="stat"><span class="stat-label">@L["كراسي متأكدة"]</span><span class="stat-value">@confirmed</span></div>
    <div class="stat"><span class="stat-label">@L["كراسي فاضية"]</span><span class="stat-value">@free</span></div>
    <a class="stat stat-signal @(Model.PendingPayments == 0 ? "is-quiet" : null)" href="/Office/Payments">
        <span class="stat-label">@L["تحويلات مستنية مراجعة"]</span>
        <span class="stat-value">@Model.PendingPayments</span>
    </a>
</div>

@if (Model.Trips.Count == 0)
{
    <div class="empty-state">
        <svg class="i i-lg"><use href="#i-calendar" /></svg>
        <p>@L["مفيش رحلات في اليوم ده. لو المواعيد متسجلة، الرحلات بتتولد لوحدها للأيام الجاية."]</p>
    </div>
}
else
{
    @foreach (var group in Model.Trips.GroupBy(t => t.Direction))
    {
        <section class="panel panel-flush">
            <header class="panel-head">
                <h2>@Fmt.Direction(group.Key)</h2>
                <span class="muted small">@L["{0} رحلة", group.Count()]</span>
            </header>
            <div class="table-responsive">
                <table class="table data-table align-middle">
                    <thead>
                        <tr>
                            <th>@L["الساعة"]</th>
                            <th>@L["الأتوبيس"]</th>
                            <th>@L["السواق"]</th>
                            <th class="w-occupancy">@L["الامتلاء"]</th>
                            <th class="num">@L["متأكد"]</th>
                            <th class="num">@L["بيراجع"]</th>
                            <th class="num">@L["مستني تحويل"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in group)
                        {
                            var used = trip.ConfirmedSeats + trip.AwaitingSeats + trip.HeldSeats;
                            var percent = trip.Capacity == 0 ? 0 : used * 100 / trip.Capacity;
                            var confirmedPercent = trip.Capacity == 0 ? 0 : trip.ConfirmedSeats * 100 / trip.Capacity;
                            <tr>
                                <td class="time-cell">@Fmt.Time(trip.DepartureTime)</td>
                                <td>@trip.BusPlateNumber</td>
                                <td>@trip.DriverName</td>
                                <td>
                                    <div class="meter meter-split" title="@used / @trip.Capacity">
                                        <span class="pending" style="width:@percent%"></span>
                                        <span style="width:@confirmedPercent%"></span>
                                    </div>
                                    <span class="muted small">@used / @trip.Capacity</span>
                                </td>
                                <td class="num">@trip.ConfirmedSeats</td>
                                <td class="num">@trip.AwaitingSeats</td>
                                <td class="num">@trip.HeldSeats</td>
                                <td class="text-end"><a class="btn btn-primary btn-sm" href="/Office/Trip/@trip.TripId">@L["الكشف"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
