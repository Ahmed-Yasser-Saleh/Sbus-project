<!DOCTYPE html>
@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isOfficeArea = page.StartsWith("/Office", StringComparison.Ordinal);
    var isOffice = isOfficeArea && User.Identity?.IsAuthenticated == true;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var otherLanguage = Languages.IsEnglish ? Languages.Arabic : Languages.English;

    string Active(string prefix, bool exact = false) =>
        (exact ? page == prefix : page.StartsWith(prefix, StringComparison.Ordinal)) ? "active" : string.Empty;
}
<html lang="@Languages.Current" dir="@Languages.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a2a55" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="~/icons/logo-icon-180x180.png" />
    <title>@(ViewData["Title"] is string title ? title + " · S Bus" : "S Bus")</title>
    @await RenderSectionAsync("Head", required: false)
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Readex+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @if (Languages.IsEnglish)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isOfficeArea ? "area-office" : "area-public")">
    <partial name="_Icons" />

    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" href="@(isOffice ? "/Office" : "/")">
                <img class="brand-wordmark" src="~/img/logo-full.png" alt="SBus" />           
                <span class="brand-route">@L["القاهرة ⇄ السويس"]</span>
            </a>

            <div class="topbar-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole(SBus.Infrastructure.Identity.Roles.Traveler)
                        && !User.IsInRole(SBus.Infrastructure.Identity.Roles.CompanyOwner)
                        && !User.IsInRole(SBus.Infrastructure.Identity.Roles.CompanyEmployee))
                    {
                        <a asp-page="/MyTickets" class="topbar-link">@L["تذاكري"]</a>
                    }
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="topbar-link">@L["خروج"]</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login" class="topbar-link">@L["تسجيل الدخول"]</a>
                }
                <a class="lang-switch" href="/Language?lang=@otherLanguage&returnUrl=@Uri.EscapeDataString(returnUrl)" lang="@otherLanguage">
                    <svg class="i"><use href="#i-globe" /></svg>
                    @(Languages.IsEnglish ? "عربي" : "English")
                </a>
            </div>
        </div>

        @if (isOffice)
        {
            <nav class="container office-tabs" aria-label="Office">
                <a class="@Active("/Office/Index", exact: true) @Active("/Office/Trip")" href="/Office">@L["الرحلات"]</a>
                <a class="@Active("/Office/Payments")" href="/Office/Payments">@L["مراجعة الدفع"]</a>
                <a class="@Active("/Office/Settings")" href="/Office/Settings">@L["الإعدادات"]</a>
            </nav>
        }
    </header>

    <main class="container page">
        @RenderBody()
    </main>

    <footer class="container site-footer">
        <span>S Bus</span>
        <span class="dot"></span>
        <span>@L["نسخة تجريبية"]</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
