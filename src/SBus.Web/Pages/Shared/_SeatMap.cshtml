@model SBus.Web.Pages.Shared.SeatMapView
<div class="bus @(Model.Selectable ? "is-selectable" : null)">
    <div class="bus-windshield">@L["قدام"]</div>
    <div class="seat-grid" style="--cols: @Model.Map.Columns;">
        @for (var row = 1; row <= Model.Map.Rows; row++)
        {
            for (var column = 1; column <= Model.Map.Columns; column++)
            {
                var cell = Model.Map.At(row, column);

                if (cell is null)
                {
                    <div class="seat-gap"></div>
                }
                else if (cell.Kind == SeatCellKind.Driver)
                {
                    <div class="seat seat-driver" title="@L["السواق"]">
                        <svg class="i"><use href="#i-wheel" /></svg>
                    </div>
                }
                else if (cell.IsTaken)
                {
                    <div class="seat seat-taken" title="@L["محجوز"]"><span>@cell.SeatNumber</span></div>
                }
                else if (Model.Selectable)
                {
                    <label class="seat seat-free">
                        <input type="checkbox" name="@Model.InputName" value="@cell.SeatNumber" @(Model.Selected.Contains(cell.SeatNumber!.Value) ? "checked" : null) />
                        <span>@cell.SeatNumber</span>
                    </label>
                }
                else
                {
                    <div class="seat seat-free seat-static"><span>@cell.SeatNumber</span></div>
                }
            }
        }
    </div>
    <div class="bus-rear"></div>
</div>
<ul class="seat-legend">
    <li><i class="legend free"></i>@L["فاضي"]</li>
    @if (Model.Selectable)
    {
        <li><i class="legend picked"></i>@L["اختيارك"]</li>
    }
    <li><i class="legend taken"></i>@L["محجوز"]</li>
</ul>
