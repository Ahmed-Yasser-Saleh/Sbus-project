@{
    Layout = "_Layout";
}

<div class="auth">
    <div class="auth-card">
        <img class="auth-wordmark" src="~/img/logo-auth.webp" width="420" height="387" asp-append-version="true" alt="SBus" />
        <h1>@ViewData["AuthHeading"]</h1>
        @RenderBody()
    </div>
</div>

@section Head {
    @await RenderSectionAsync("Head", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
